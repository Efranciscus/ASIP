import React from 'react';
import { Check, Circle } from 'lucide-react';

export default function SetupChecklist({ steps }) {
  return (
    <div className="rounded-xl border border-stone-200 bg-white p-6">
      <h2 className="font-heading text-sm tracking-[0.25em] uppercase text-stone-500">Setup Sequence</h2>
      <ul className="mt-5 space-y-4">
        {steps.map((s) => (
          <li key={s.label} className="flex gap-3">
            <span className={`mt-0.5 ${s.done ? 'text-emerald-600' : 'text-stone-300'}`}>
              {s.done ? <Check className="w-4 h-4" /> : <Circle className="w-4 h-4" />}
            </span>
            <div>
              <p className={`text-sm font-medium ${s.done ? 'text-stone-900' : 'text-stone-500'}`}>{s.label}</p>
              <p className="text-xs text-stone-400 leading-relaxed">{s.hint}</p>
            </div>
          </li>
        ))}
      </ul>
    </div>
  );
}
