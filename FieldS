import React from 'react';
import { Battery, Radio as RadioIcon, Mic } from 'lucide-react';

export default function FieldSetup({ r }) {
  const items = [
    { key: 'battery', label: 'Battery', Icon: Battery, on: r.battery, set: r.setBattery },
    { key: 'antenna', label: 'Antenna', Icon: RadioIcon, on: r.antenna, set: r.setAntenna },
    { key: 'handmic', label: 'Handmic', Icon: Mic, on: r.handmic, set: r.setHandmic },
  ];
  return (
    <div className="rounded-xl border border-stone-200 bg-white p-6">
      <h2 className="font-heading text-sm tracking-[0.25em] uppercase text-stone-500">Field Setup</h2>
      <p className="mt-2 text-xs text-stone-400 leading-relaxed">Connect hardware before powering up.</p>
      <div className="mt-4 space-y-2">
        {items.map((it) => {
          const Icon = it.Icon;
          return (
            <button
              key={it.key}
              onClick={() => it.set(!it.on)}
              className={`w-full flex items-center gap-3 rounded-lg border px-3 py-2.5 text-left transition-colors ${
                it.on ? 'border-emerald-200 bg-emerald-50 text-emerald-800' : 'border-stone-200 bg-stone-50 text-stone-500 hover:bg-stone-100'
              }`}
            >
              <Icon className="w-4 h-4" />
              <span className="text-sm font-medium flex-1">{it.label}</span>
              <span className={`text-[10px] font-mono tracking-widest ${it.on ? 'text-emerald-600' : 'text-stone-400'}`}>
                {it.on ? 'CONNECTED' : 'DISCONNECTED'}
              </span>
            </button>
          );
        })}
      </div>
    </div>
  );
}
