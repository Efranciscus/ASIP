import React from 'react';
import { Check, Clock, Target, AlertCircle, Loader2 } from 'lucide-react';

export default function SessionSummary({ session, status }) {
  if (!session) return null;
  return (
    <div className="rounded-xl border border-stone-200 bg-white p-6">
      <h2 className="font-heading text-sm tracking-[0.25em] uppercase text-stone-500">Session Complete</h2>
      <div className="mt-4 grid grid-cols-3 gap-3 text-center">
        <div className="rounded-lg bg-stone-50 p-3">
          <Clock className="w-4 h-4 mx-auto text-stone-400" />
          <div className="mt-1 font-mono text-lg text-stone-800">{session.completionTime}s</div>
          <div className="text-[10px] text-stone-400 tracking-widest">TIME</div>
        </div>
        <div className="rounded-lg bg-stone-50 p-3">
          <Target className="w-4 h-4 mx-auto text-stone-400" />
          <div className="mt-1 font-mono text-lg text-stone-800">{session.accuracy}%</div>
          <div className="text-[10px] text-stone-400 tracking-widest">ACCURACY</div>
        </div>
        <div className="rounded-lg bg-stone-50 p-3">
          <AlertCircle className="w-4 h-4 mx-auto text-stone-400" />
          <div className="mt-1 font-mono text-lg text-stone-800">{session.errors}</div>
          <div className="text-[10px] text-stone-400 tracking-widest">ERRORS</div>
        </div>
      </div>
      <div className="mt-4 flex items-center gap-2 text-xs">
        {status === 'saving' && (
          <>
            <Loader2 className="w-3.5 h-3.5 animate-spin text-stone-400" />
            <span className="text-stone-500">Saving to Google Sheets…</span>
          </>
        )}
        {status === 'saved' && (
          <>
            <Check className="w-3.5 h-3.5 text-emerald-600" />
            <span className="text-emerald-700">Saved to Google Sheets.</span>
          </>
        )}
        {status === 'error' && (
          <>
            <AlertCircle className="w-3.5 h-3.5 text-amber-600" />
            <span className="text-amber-700">Could not save to Google Sheets — your session was still recorded.</span>
          </>
        )}
      </div>
    </div>
  );
}
