import React, { useEffect, useState } from 'react';
import { useNavigate } from 'react-router-dom';
import { LogOut } from 'lucide-react';
import useRadio from '@/hooks/useRadio';
import usePracticeSession from '@/hooks/usePracticeSession';
import RadioFace from '@/components/radio/RadioFace';
import SetupChecklist from '@/components/radio/SetupChecklist';
import FieldSetup from '@/components/radio/FieldSetup';
import SessionSummary from '@/components/radio/SessionSummary';

export default function Radio() {
  const navigate = useNavigate();
  const [user, setUser] = useState(null);

  useEffect(() => {
    const raw = localStorage.getItem('asip_user');
    if (!raw) { navigate('/signin'); return; }
    try { setUser(JSON.parse(raw)); } catch { navigate('/signin'); }
  }, []);

  const r = useRadio();
  const { session, status } = usePracticeSession({ r, user });

  if (!user) return null;

  const loadedCount = Object.keys(r.channels).length;
  const steps = [
    { label: 'Install battery', hint: 'Install a battery pack to power the radio.', done: r.battery },
    { label: 'Connect antenna', hint: 'Attach the antenna to the top connector.', done: r.antenna },
    { label: 'Connect handmic', hint: 'Plug the handmic into the audio jack.', done: r.handmic },
    { label: 'Power up — FCTN to STBY', hint: 'Turn the FCTN knob to STBY.', done: r.powered },
    { label: 'FCTN to LD', hint: 'Load mode is required to enter a frequency.', done: r.fctn === 'LD' || loadedCount > 0 },
    { label: 'Load a frequency', hint: 'FREQ → 5 digits (30000–87975, 25 kHz steps) → STO → channel 1–6. Or turn to Z to reset to FH.', done: loadedCount > 0 || r.opMode === 'FH' },
    { label: 'Set volume', hint: 'MENU/CLR → VOL → press 1–5.', done: r.volume > 0 },
    { label: 'Set power & mode', hint: 'MENU/CLR → PWR (LO/ME/HI) and MODE (SC/PT, SC/CT, FH).', done: r.powered },
    { label: 'FCTN to SQ', hint: 'Turn FCTN to SQ to go operational.', done: r.fctn === 'SQ' || r.fctn === 'ON' },
    { label: 'Radio operational', hint: 'Push-To-Talk is unlocked.', done: r.ready },
  ];

  const signOut = () => {
    localStorage.removeItem('asip_user');
    navigate('/signin');
  };

  return (
    <div className="min-h-screen bg-stone-50">
      <div className="max-w-6xl mx-auto px-6 py-14">
        <header className="mb-12 flex items-start justify-between gap-4">
          <div>
            <p className="font-mono text-[11px] tracking-[0.35em] text-stone-400 uppercase">Field Trainer</p>
            <h1 className="mt-3 font-heading text-4xl sm:text-5xl font-light tracking-tight text-stone-900">
              AN/PRC-119F ASIP
            </h1>
            <p className="mt-3 max-w-xl text-stone-500 leading-relaxed">
              Operate the faceplate as you would in the field. The set will only key up once it is
              configured correctly — battery, antenna, handmic, and a loaded frequency (or FH mode).
            </p>
          </div>
          <div className="flex flex-col items-end gap-2 shrink-0">
            <div className="text-right">
              <div className="text-[10px] font-mono tracking-widest text-stone-400 uppercase">Signed in</div>
              <div className="text-sm font-medium text-stone-700">{user.name}</div>
              <div className="text-xs text-stone-400">{user.email}</div>
            </div>
            <button
              onClick={signOut}
              className="inline-flex items-center gap-1.5 text-xs text-stone-500 hover:text-stone-800"
            >
              <LogOut className="w-3.5 h-3.5" /> Sign out
            </button>
          </div>
        </header>

        <div className="grid lg:grid-cols-[minmax(0,1fr)_320px] gap-10 items-start">
          <RadioFace r={r} />
          <div className="space-y-6">
            {session && <SessionSummary session={session} status={status} />}
            <FieldSetup r={r} />
            <SetupChecklist steps={steps} />
            <div className="rounded-xl border border-stone-200 bg-white p-6">
              <h2 className="font-heading text-sm tracking-[0.25em] uppercase text-stone-500">Loaded Channels</h2>
              <div className="mt-4 grid grid-cols-3 gap-2 font-mono text-xs">
                {['1', '2', '3', '4', '5', '6'].map((c) => (
                  <div
                    key={c}
                    className={`rounded border px-2 py-2 text-center ${
                      r.channels[c] ? 'border-emerald-200 bg-emerald-50 text-emerald-800' : 'border-stone-200 text-stone-300'
                    }`}
                  >
                    <div className="text-[10px] tracking-widest">CH {c}</div>
                    <div>{r.channels[c] || '-----'}</div>
                  </div>
                ))}
              </div>
              <p className="mt-4 text-xs text-stone-400 leading-relaxed">
                Turning FCTN to Z zeroizes all fills and resets the radio to FH mode, just like the real set.
              </p>
              <p className="mt-2 text-xs text-stone-400 leading-relaxed">
                Press <span className="font-mono text-stone-500">MENU/CLR</span> to adjust volume, channel, power output, and operating mode (FH, SC/PT, or SC/CT).
              </p>
            </div>
          </div>
        </div>
      </div>
    </div>
  );
}
