import React from 'react';
import RadioDisplay from './RadioDisplay';
import FctnKnob from './FctnKnob';
import RadioButton from './RadioButton';

const WaveIcon = (
  <svg width="24" height="14" viewBox="0 0 24 14" fill="none" stroke="#f7d560" strokeWidth="1.6" strokeLinecap="round">
    <path d="M2 7 C 4 2, 6 2, 8 7 C 10 12, 12 12, 14 7 C 16 2, 18 2, 20 7" />
  </svg>
);

const KEYPAD = [
  [{ t: 'CMSC', n: '1', k: '1' }, { t: 'RCU', n: '2', k: '2' }, { t: 'SYNC', n: '3', k: '3' }, { t: 'FREQ', n: null, k: 'FREQ', icon: WaveIcon }],
  [{ t: 'DATA', n: '4', k: '4' }, { t: 'GPS', n: '5', k: '5' }, { t: 'SA', n: '6', k: '6' }, { t: 'ERF', n: 'OFST', k: 'ERF' }],
  [{ t: 'CHG', n: '7', k: '7' }, { t: 'CID', n: '8', k: '8' }, { t: 'LOUT', n: '9', k: '9' }, { t: 'TIME', n: null, k: 'TIME' }],
  [{ t: 'MENU', n: 'CLR', k: 'CLR' }, { t: 'LOAD', n: '0', k: '0' }, { t: 'STO', n: null, k: 'STO' }, { t: 'BATT', n: 'CALL', k: 'BATT' }],
];

function Screw() {
  return (
    <div className="w-2.5 h-2.5 rounded-full bg-[#2a2a2a] shadow-[inset_0_1px_1px_rgba(0,0,0,0.7)] relative">
      <div className="absolute top-1/2 left-0 right-0 h-px bg-black/60 -translate-y-1/2 rotate-45" />
    </div>
  );
}

function Port({ label }) {
  return (
    <div className="flex flex-col items-center gap-2">
      <div className="text-[9px] font-mono tracking-widest text-white/85">{label}</div>
      <div className="w-[78px] h-[78px] rounded-full bg-[#1a1a1a] border-2 border-black/70 shadow-[inset_0_2px_6px_rgba(0,0,0,0.7)] flex items-center justify-center">
        <div className="grid grid-cols-3 gap-1.5">
          {[...Array(6)].map((_, i) => (
            <div key={i} className="w-2 h-2 rounded-full bg-[#4a4a4a] border border-black/60" />
          ))}
        </div>
      </div>
    </div>
  );
}

function AntennaConnector({ connected, onClick }) {
  return (
    <button onClick={onClick} className="flex flex-col items-center gap-1" aria-label="Antenna connector">
      {connected ? (
        <div className="flex flex-col items-center">
          <div className="w-1.5 h-9 bg-[#3a3a3a] rounded-t border border-black/60" />
          <div className="w-3 h-3 rounded-full bg-[#5a5a5a] border border-black/60 -mt-1" />
        </div>
      ) : (
        <div className="w-3 h-11" />
      )}
      <div className={`w-10 h-10 rounded-full border-2 flex items-center justify-center transition-colors ${
        connected ? 'bg-[#1a1a1a] border-black/70' : 'bg-[#2a2a2a] border-black/40 opacity-60'
      }`}>
        <div className="w-4 h-4 rounded-full bg-[#3a3a3a] border border-black/60" />
      </div>
      <div className={`text-[8px] font-mono tracking-widest ${connected ? 'text-[#f7d560]' : 'text-red-300/80'}`}>
        {connected ? 'ANT' : 'NO ANT'}
      </div>
    </button>
  );
}

export default function RadioFace({ r }) {
  return (
    <div className="rounded-xl p-6 bg-[#4b523d] border-[3px] border-black/70 shadow-[0_25px_50px_-12px_rgba(0,0,0,0.6)]">
      <div className="grid gap-6 items-start lg:grid-cols-[220px_minmax(0,1fr)_170px]">
        {/* LEFT — antenna + FCTN */}
        <div className="flex flex-col items-center gap-3 pt-1">
          <AntennaConnector connected={r.antenna} onClick={() => r.setAntenna(!r.antenna)} />
          <FctnKnob positions={r.FCTN_POSITIONS} value={r.fctn} onChange={r.turnFctn} />
        </div>

        {/* CENTER — recessed console */}
        <div className="relative rounded-lg p-5 pt-7 bg-[#3d4234] border-2 border-black/60 shadow-[inset_0_2px_8px_rgba(0,0,0,0.5)]">
          <div className="absolute top-2 left-2"><Screw /></div>
          <div className="absolute top-2 right-2"><Screw /></div>
          <div className="absolute bottom-2 left-2"><Screw /></div>
          <div className="absolute bottom-2 right-2"><Screw /></div>

          <div className="grid grid-cols-4 gap-2 mb-3 px-8">
            {['PWR', 'MODE', 'CHAN', 'CMSC'].map((l) => (
              <div key={l} className="text-center text-[9px] font-mono tracking-widest text-white/85">{l}</div>
            ))}
          </div>

          <div className="px-6 mb-4">
            <RadioDisplay powered={r.powered} display={r.display} sub={r.sub} badge={r.badge} xmit={r.xmit} />
          </div>

          <div className="grid grid-cols-4 gap-2 px-6">
            {KEYPAD.flat().map((b, i) => (
              <RadioButton
                key={i}
                top={b.t}
                bottom={b.n}
                icon={b.icon}
                onClick={() => b.k && r.press(b.k)}
              />
            ))}
          </div>

          <div className="mt-5 mx-auto w-2/3 h-2 rounded-full bg-black/50" />
        </div>

        {/* RIGHT — ports */}
        <div className="flex flex-col items-center gap-8 pt-4 relative">
          <Port label="AUD/FILL" />
          <Port label="AUD/DATA" />
          <div className="absolute bottom-0 right-2 text-[8px] font-mono tracking-widest text-white/40">RXMT</div>
        </div>
      </div>

      {/* handset + PTT */}
      <div className="mt-6 flex items-center gap-4">
        <button
          onClick={() => r.setHandmic(!r.handmic)}
          className="flex flex-col items-center gap-1"
          aria-label="Handmic jack"
        >
          <div className={`w-12 h-12 rounded-full border-2 flex items-center justify-center transition-colors ${
            r.handmic ? 'bg-[radial-gradient(circle,#5a604e,#20241b)] border-black/70' : 'bg-[#2a2a2a] border-black/40 opacity-60'
          }`}>
            <div className="w-5 h-5 rounded-full bg-[#1a1a1a] border border-black/60" />
          </div>
          <div className={`text-[8px] font-mono tracking-widest ${r.handmic ? 'text-[#f7d560]' : 'text-red-300/80'}`}>
            {r.handmic ? 'MIC' : 'NO MIC'}
          </div>
        </button>
        <button
          onMouseDown={() => r.ready && !r.menu && r.setXmit(true)}
          onMouseUp={() => r.setXmit(false)}
          onMouseLeave={() => r.setXmit(false)}
          onTouchStart={() => r.ready && !r.menu && r.setXmit(true)}
          onTouchEnd={() => r.setXmit(false)}
          className={`flex-1 h-12 rounded-lg font-mono text-xs tracking-[0.25em] border border-black/60 transition-all ${
            r.ready && !r.menu
              ? 'bg-[#5a604e] text-[#f7d560] hover:bg-[#66705a] active:translate-y-[2px]'
              : 'bg-[#2b3025] text-white/30 cursor-not-allowed'
          }`}
        >
          {r.xmit ? 'KEYED — TRANSMITTING' : 'PUSH TO TALK'}
        </button>
      </div>
    </div>
  );
}
